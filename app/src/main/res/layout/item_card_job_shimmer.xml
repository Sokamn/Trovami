<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginStart="15dp">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/imvBGWhiteJIS"
        android:layout_width="230dp"
        android:layout_height="60dp"
        app:strokeWidth="0dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="@color/white"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/imvJobJIS"
        app:shapeAppearanceOverlay="@style/roundImageBottom40pcg">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/imvUbicationJIS"
                android:layout_width="match_parent"
                android:layout_height="12dp"
                android:layout_marginStart="15dp"
                android:layout_marginEnd="115dp"
                android:layout_marginBottom="12dp"
                android:background="#ECECEC"
                android:elevation="1dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.0"
                app:layout_constraintStart_toStartOf="parent"
                app:shapeAppearanceOverlay="@style/circle" />

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/txvKindJobJIS"
                android:layout_width="0dp"
                android:layout_height="14dp"
                android:layout_marginStart="15dp"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="35dp"
                android:background="#D9D9D9"
                android:elevation="1dp"
                app:shapeAppearanceOverlay="@style/circle"
                app:layout_constraintEnd_toEndOf="@+id/imvUbicationJIS"
                app:layout_constraintHorizontal_bias="0.0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/imvJobJIS"
        android:layout_width="230dp"
        android:layout_height="110dp"
        android:background="#ECECEC"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:shapeAppearanceOverlay="@style/roundImageTop20dp" />

    <com.google.android.material.card.MaterialCardView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="25dp"
        android:backgroundTint="#D7D7D7"
        app:cardElevation="0dp"
        app:cardCornerRadius="15dp"
        app:layout_constraintBottom_toTopOf="@+id/imvBGWhiteJIS"
        app:layout_constraintEnd_toEndOf="@+id/imvJobJIS"
        app:layout_constraintTop_toTopOf="@+id/imvBGWhiteJIS">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/crdPayment"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/txvPriceJIS"
                android:layout_width="37dp"
                android:layout_height="11dp"
                android:layout_marginStart="13dp"
                android:layout_marginTop="15dp"
                android:layout_marginEnd="13dp"
                android:background="#ECECEC"
                android:elevation="1dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:shapeAppearanceOverlay="@style/circle" />

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/txvPaymentPeriod"
                android:layout_width="30dp"
                android:layout_height="9dp"
                android:layout_marginStart="15dp"
                android:layout_marginTop="5dp"
                android:layout_marginEnd="15dp"
                android:layout_marginBottom="15dp"
                android:background="#ECECEC"
                android:elevation="1dp"
                app:shapeAppearanceOverlay="@style/circle"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/txvPriceJIS" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>