<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:tools="http://schemas.android.com/tools"
    android:layout_height="wrap_content"
    android:layout_width="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <TextView
        android:id="@+id/txvUserNameUCI"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:fontFamily="@font/medium"
        android:maxLines="1"
        android:text="@string/jobChat"
        android:textAlignment="center"
        android:textColor="@color/white"
        android:textSize="8sp"
        app:layout_constraintEnd_toEndOf="@+id/imvPhotoUCI"
        app:layout_constraintStart_toStartOf="@+id/imvPhotoUCI"
        app:layout_constraintTop_toBottomOf="@+id/imvPhotoUCI" />

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/imvPhotoUCI"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:src="@drawable/profile_picture"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:shapeAppearanceOverlay="@style/circle" />
</androidx.constraintlayout.widget.ConstraintLayout>