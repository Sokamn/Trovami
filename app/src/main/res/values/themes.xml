<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.Trovami" parent="Theme.Material3.DayNight.NoActionBar">

    </style>

    <style name="CustomBottomSheetDialogTheme" parent="Theme.Design.Light.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/CustomBottomSheetStyle</item>
    </style>

    <style name="CustomBottomSheetStyle" parent="Widget.Design.BottomSheet.Modal">
        <item name="android:background">@android:color/transparent</item>
    </style>

    <style name="Button" parent="Widget.Material3.Button">
        <item name="android:paddingTop">8sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">@font/semibold</item>
        <item name="android:textSize">14sp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:gravity">center</item>
        <item name="rippleColor">@color/shimmerColor</item>
        <item name="cornerRadius">10dp</item>
    </style>

    <style name="PrimaryButton" parent="Button">
        <item name="android:textColor">@color/white</item>
        <item name="android:backgroundTint">@color/secundaryColor</item>
    </style>

    <style name="PrimaryOutlinedButton" parent="Button">
        <item name="android:textColor">@color/primaryColor</item>
        <item name="android:backgroundTint">@color/white</item>
        <item name="strokeColor">@color/shimmerColor</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="SecundaryButton" parent="Button">
        <item name="android:textColor">@color/primaryColor</item>
        <item name="android:backgroundTint">@color/white</item>
    </style>
    
    <style name="PrimaryButton.DialogButton" parent="PrimaryButton">
        <item name="cornerRadius">20dp</item>
    </style>

    <style name="PrimaryOutlinedButton.DialogButton" parent="PrimaryOutlinedButton">
        <item name="cornerRadius">20dp</item>
    </style>

    <style name="TabFont" parent="TextAppearance.Design.Tab">
        <item name="android:fontFamily">@font/semibold</item>
        <item name="android:textSize">11sp</item>
        <item name="textAllCaps">false</item>
    </style>

    <style name="roundImageProfile20dp" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">20dp</item>
    </style>

    <style name="bottomNavTextActive">
        <item name="android:textSize">8sp</item>
        <item name="android:fontFamily">@font/semibold</item>
    </style>
    <style name="bottomNavTextInactive">
        <item name="android:textSize">8sp</item>
        <item name="android:fontFamily">@font/semibold</item>
    </style>

    <style name="circle" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>
    <style name="bototom40percent" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeBottomRight">100dp</item>
        <item name="cornerSizeBottomLeft">100dp</item>
    </style>
    <style name="roundImageBottom20dp" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">0dp</item>
        <item name="cornerSizeBottomLeft">20dp</item>
        <item name="cornerSizeBottomRight">20dp</item>
    </style>
    <style name="roundImageBottom40pcg" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">0dp</item>
        <item name="cornerSizeBottomLeft">40%</item>
        <item name="cornerSizeBottomRight">40%</item>
    </style>
    <style name="roundImageTop20dp" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">0dp</item>
        <item name="cornerSizeTopRight">20dp</item>
        <item name="cornerSizeTopLeft">20dp</item>
    </style>
    <style name="roundImage5dp" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">5dp</item>
    </style>
    <style name="roundImage10dp" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">10dp</item>
    </style>
    <style name="roundImage15dp" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">15dp</item>
    </style>
    <style name="roundImageProfile40dp" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">19dp</item>
    </style>

    <style name="EPTextInputLayout" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense">
        <item name="android:gravity">center_vertical</item>
        <item name="errorEnabled">true</item>
        <item name="android:layout_marginLeft">16dp</item>
        <item name="android:layout_marginRight">16dp</item>
        <item name="android:textColorHint">@color/quaternaryColor</item>
        <item name="boxStrokeColor">@drawable/bg_editext_edit_profile</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="errorTextColor">@color/secundaryColor</item>
        <item name="hintTextColor">@color/quaternaryColor</item>
        <item name="fontFamily">@font/regular</item>
        <item name="cornerRadius">10dp</item>
        <item name="startIconTint">@color/tertiaryColor</item>
        <item name="endIconTint">@color/primaryColor</item>
    </style>

    <style name="FormTextInputLayout" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense">
        <item name="android:gravity">center_vertical</item>
        <item name="errorEnabled">true</item>
        <item name="android:layout_marginLeft">16dp</item>
        <item name="android:layout_marginRight">16dp</item>
        <item name="android:textColorHint">@color/textColor</item>
        <item name="boxStrokeColor">@drawable/bg_editext_login</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="errorTextColor">@color/textColor</item>
        <item name="hintTextColor">@color/secundaryColor</item>
        <item name="fontFamily">@font/regular</item>
        <item name="cornerRadius">10dp</item>
        <item name="startIconTint">@color/textColor</item>
        <item name="endIconTint">@color/textColor</item>
    </style>

    <style name="DefaultTextView" parent="Widget.AppCompat.TextView">
        <item name="android:fontFamily">@font/regular</item>
        <item name="android:textColor">@color/primaryColor</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="CaptionText" parent="Widget.AppCompat.TextView">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/secundaryColor</item>
        <item name="android:gravity">center</item>
        <item name="android:fontFamily">@font/bold</item>
    </style>

    <style name="FormEditText" parent="Widget.AppCompat.EditText">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/textColor</item>
        <item name="android:paddingLeft">16dp</item>
        <item name="singleLine">true</item>
        <item name="maxLines">1</item>
        <item name="android:paddingRight">16dp</item>
        <item name="android:textColorHint">@color/textColor</item>
        <item name="android:fontFamily">@font/regular</item>
    </style>

    <style name="AuthDescriptionTextView" parent="DefaultTextView">
        <item name="android:fontFamily">@font/medium</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="AuthDescriptionTextView.MasterDialog" parent="AuthDescriptionTextView">
        <item name="android:textSize">14sp</item>
    </style>

    <style name="AuthTitleTextView" parent="DefaultTextView">
        <item name="android:fontFamily">@font/bold</item>
        <item name="android:textSize">22sp</item>
    </style>

    <style name="AuthTitleTextView.DialogTitle" parent="AuthTitleTextView">
        <item name="android:fontFamily">@font/semibold</item>
        <item name="android:textSize">20sp</item>
    </style>

    <style name="CategoryTitle" parent="DefaultTextView">
        <item name="android:fontFamily">@font/bold</item>
        <item name="android:textSize">18sp</item>
    </style>

    <style name="DefaultCardButton" parent="Widget.Material3.CardView.Filled">
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
        <item name="cardBackgroundColor">@color/white</item>
        <item name="cardCornerRadius">10dp</item>
        <item name="cardElevation">0dp</item>
        <item name="rippleColor">@color/shimmerColor</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">@color/textColor</item>
    </style>

    <style name="AuthCardButton" parent="DefaultCardButton">
        <item name="cardElevation">1dp</item>
    </style>

    <style name="CardMasterButton" parent="DefaultCardButton">
        <item name="contentPadding">10dp</item>
    </style>

    <style name="MasterCardButton" parent="DefaultCardButton">
        <item name="cardCornerRadius">20dp</item>
        <item name="strokeColor">@color/bg</item>
    </style>

</resources>