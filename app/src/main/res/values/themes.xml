<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.Trovami" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- primaryColor brand color. -->
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
        <!-- Customize your theme here. -->
    </style>

    <style name="SecundaryButton" parent="Widget.MaterialComponents.Button">
        <item name="android:fontFamily">@font/semibold</item>
        <item name="android:paddingTop">5sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/primaryColor</item>
        <item name="android:textSize">14sp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:backgroundTint">@color/white</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="PrimaryButton" parent="Widget.MaterialComponents.Button">
        <item name="android:paddingTop">5sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">14sp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:backgroundTint">@color/secundaryColor</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:gravity">center</item>
        <item name="rippleColor">@color/textColor</item>
        <item name="cornerRadius">10dp</item>
    </style>

    <style name="PrimaryOutlinedButton" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:paddingTop">5sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/primaryColor</item>
        <item name="android:textSize">14sp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:backgroundTint">@color/white</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="TabFont" parent="TextAppearance.Design.Tab">
        <item name="android:fontFamily">@font/semibold</item>
        <item name="android:textSize">11sp</item>
        <item name="textAllCaps">false</item>
    </style>

    <style name="roundImageProfile20dp" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">20dp</item>
    </style>

    <style name="bottomNavTextActive">
        <item name="android:textSize">8sp</item>
        <item name="android:fontFamily">@font/semibold</item>
    </style>
    <style name="bottomNavTextInactive">
        <item name="android:textSize">8sp</item>
        <item name="android:fontFamily">@font/semibold</item>
    </style>

    <style name="circle" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>
    <style name="bototom40percent" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeBottomRight">100dp</item>
        <item name="cornerSizeBottomLeft">100dp</item>
    </style>
    <style name="roundImageBottom20dp" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">0dp</item>
        <item name="cornerSizeBottomLeft">40%</item>
        <item name="cornerSizeBottomRight">40%</item>
    </style>
    <style name="roundImageTop20dp" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">0dp</item>
        <item name="cornerSizeTopRight">20dp</item>
        <item name="cornerSizeTopLeft">20dp</item>
    </style>
    <style name="roundImage5dp" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">5dp</item>
    </style>
    <style name="roundImage10dp" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">10dp</item>
    </style>
    <style name="roundImage15dp" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">15dp</item>
    </style>








    <style name="CaptionText" parent="Widget.AppCompat.TextView">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/secundaryColor</item>
        <item name="android:gravity">center</item>
        <item name="android:fontFamily">@font/bold</item>
    </style>

    <style name="BodyText" parent="Widget.AppCompat.TextView">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/secundaryColor</item>
        <item name="android:gravity">center</item>
        <item name="android:fontFamily">@font/bold</item>
    </style>

    <style name="TitleText" parent="Widget.AppCompat.TextView">
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/secundaryColor</item>
        <item name="android:gravity">center</item>
        <item name="android:fontFamily">@font/bold</item>
    </style>

    <style name="primaryColorButton" parent="Widget.MaterialComponents.Button">
        <item name="android:textSize">12sp</item>
        <item name="textAllCaps">true</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textColor">@color/secundaryColor</item>
        <item name="android:gravity">center</item>
        <item name="backgroundTint">@color/primaryColor</item>
        <item name="android:fontFamily">@font/bold</item>
    </style>

    <style name="secundaryColorButton" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="strokeColor">@color/primaryColor</item>
        <item name="android:textSize">12sp</item>
        <item name="textAllCaps">true</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textColor">@color/primaryColor</item>
        <item name="android:gravity">center</item>
        <item name="android:fontFamily">@font/bold</item>
    </style>

    <style name="FormEditText" parent="Widget.AppCompat.EditText">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/textColor</item>
        <item name="android:paddingLeft">16dp</item>
        <item name="singleLine">true</item>
        <item name="maxLines">1</item>
        <item name="android:paddingRight">16dp</item>
        <item name="android:textColorHint">@color/textColor</item>
        <item name="android:fontFamily">@font/regular</item>
    </style>

    <style name="FormTextInputLayout" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense">
        <item name="android:gravity">center_vertical</item>
        <item name="errorEnabled">true</item>
        <item name="android:layout_marginLeft">16dp</item>
        <item name="android:layout_marginRight">16dp</item>
        <item name="android:textColorHint">@color/textColor</item>
        <item name="boxStrokeColor">@drawable/bg_editext_login</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="errorTextColor">@color/textColor</item>
        <item name="hintTextColor">@color/secundaryColor</item>
        <item name="fontFamily">@font/regular</item>
        <item name="cornerRadius">10dp</item>
        <item name="startIconTint">@color/textColor</item>
        <item name="endIconTint">@color/textColor</item>
    </style>
</resources>